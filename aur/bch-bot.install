# bch-bot .install script
# Runs at install/upgrade/removal time.

# The shim lands at /usr/bin/bch-bot but the code it dispatches to lives in
# /usr/lib/bch-bot. Without BCH_ROOT the shim resolves its own directory's
# parent, which for /usr/bin is /usr -- so every subcommand would look for
# /usr/scripts and fail. This profile is what makes the packaged CLI work.
_bch_root() {
  echo 'export BCH_ROOT=/usr/lib/bch-bot'
}

post_install() {
  _bch_root > /etc/profile.d/bch-bot.sh
  chmod 0644 /etc/profile.d/bch-bot.sh

  echo "==> bch-bot installed."
  echo "    Run 'bch-bot create-wallet' to generate a new wallet."
  echo "    Set BCH_WALLET_DIR to choose where the wallet is stored (default: ~/.bch-wallet)."
  echo "    Your wallet lives OUTSIDE the package and is never touched by upgrades."
}

post_upgrade() {
  post_install
}

pre_remove() {
  echo "==> bch-bot is being removed."
  echo "    Your wallet at ~/.bch-wallet (or wherever BCH_WALLET_DIR points) is NOT removed."
  echo "    Back it up manually if you want to keep it."
}

post_remove() {
  rm -f /etc/profile.d/bch-bot.sh
  echo "==> bch-bot removed. Wallet files (if any) remain in place."
}
