# Maintainer: Jav <luke@htmapro.com>
# Contributor: bch-bot contributors

pkgname=bch-bot
pkgver=0.4.1
pkgrel=1
pkgdesc="Self-custodial Bitcoin Cash (BCH) + CashTokens wallet bot. Node.js + libauth + public Rostrum. (public mirror release)"
arch=('x86_64' 'aarch64')
url="https://github.com/lucasmcducas/bch-bot-public"
license=('MIT')
depends=('nodejs>=22')
makedepends=('git' 'npm')
optdepends=(
  'omarchy: full Quickshell widget integration via bch-bot-omarchy plugin'
)
provides=("${pkgname}")
conflicts=("${pkgname}-git")
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/lucasmcducas/bch-bot-public/archive/refs/tags/v${pkgver}.tar.gz")
# sha256sums updated at release time via `updpkgsums`
sha256sums=('SKIP')  # Replace with real sha256sums before publishing to AUR

build() {
  cd "${pkgname}-${pkgver}"
  # Production deps only; no dev/test deps in the package. The lockfile is
  # committed, so this is reproducible -- npm ci fails loudly if it is not.
  npm ci --omit=dev
  # Run the test suite as a build gate. A wallet that ships with failing tests
  # is a wallet signing transactions nobody verified.
  npm test
}

package() {
  cd "${pkgname}-${pkgver}"

  # Install lib + scripts into /usr/lib/bch-bot
  install -dm755 "${pkgdir}/usr/lib/bch-bot"
  cp -r lib "${pkgdir}/usr/lib/bch-bot/lib"
  cp -r scripts "${pkgdir}/usr/lib/bch-bot/scripts"
  cp package.json "${pkgdir}/usr/lib/bch-bot/"
  cp package-lock.json "${pkgdir}/usr/lib/bch-bot/"
  cp -r node_modules "${pkgdir}/usr/lib/bch-bot/node_modules"

  # Install the CLI shim as /usr/bin/bch-bot. The shim locates its runtime by
  # probing, so it needs no environment set up at install time.
  install -Dm755 bin/bch-bot "${pkgdir}/usr/bin/bch-bot"

  # Install license + readme
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  if [ -f README.md ]; then
    install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  fi
}

# vim:set ts=2 sw=2 et:
